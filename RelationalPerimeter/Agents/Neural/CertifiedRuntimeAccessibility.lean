import RelationalPerimeter.Agents.Neural.CertifiedRuntime

/-!
# Accessibility of every state produced by the closed runtime API

Reachability is generated only by the generic initial runtime and successful
calls to its `submitUpdate`.  The accessibility theorem returns the exact
dependent history stored by the reached runtime together with constructive
soundness evidence for every step.  The one-step public instance is a typed
specialization, not a bound in the generic accessibility construction.
-/
set_option genInjectivity false
namespace ConstitutiveSearch.NeuralAgent

/-! ## Generic accessibility -/

/-- Reachability generated by the generic runtime's initial state and its sole
state-changing operation.  The update type is indexed by the exact source
agent and the accepted result fixes the exact target runtime. -/
inductive CertifiedRuntimeReachable
    {constitution : ConstitutiveMetaContract}
    (checker : DependentIncrementalChecker constitution)
    {initialContract : constitution.Contract}
    (initial : CheckedAgent constitution initialContract) :
    CertifiedRuntime checker initial -> Type 9
  | initial : CertifiedRuntimeReachable checker initial
      (initialCertifiedRuntime checker initial)
  | submitted
      (source next : CertifiedRuntime checker initial)
      (update : checker.Update source.current)
      (sourceReachable :
        CertifiedRuntimeReachable checker initial source)
      (accepted : submitUpdate source update = .ok next) :
      CertifiedRuntimeReachable checker initial next

/-- Exact accessibility evidence carried by a generic runtime. -/
structure CertifiedRuntimeAccessibility
    {constitution : ConstitutiveMetaContract}
    {checker : DependentIncrementalChecker constitution}
    {initialContract : constitution.Contract}
    {initial : CheckedAgent constitution initialContract}
    (runtime : CertifiedRuntime checker initial) : Type 9 where
  history : CertifiedRuntimeHistory checker initial runtime.current
  everyStep : EveryRuntimeStepSatisfies history
  contractPreservation : EveryRuntimeStepPreservesContracts history

/-- Every constructible generic runtime contains its exact certified history;
accessibility is therefore obtained without reconstructing any transition. -/
def CertifiedRuntime.accessibility
    {constitution : ConstitutiveMetaContract}
    {checker : DependentIncrementalChecker constitution}
    {initialContract : constitution.Contract}
    {initial : CheckedAgent constitution initialContract}
    (runtime : CertifiedRuntime checker initial) :
    CertifiedRuntimeAccessibility runtime :=
  { history := runtime.history
    everyStep := runtime.checkedHistory
    contractPreservation := runtime.preservedContracts }

def reachableRuntime_accessibility
    {constitution : ConstitutiveMetaContract}
    {checker : DependentIncrementalChecker constitution}
    {initialContract : constitution.Contract}
    {initial : CheckedAgent constitution initialContract}
    (runtime : CertifiedRuntime checker initial)
    (_reachable : CertifiedRuntimeReachable checker initial runtime) :
    CertifiedRuntimeAccessibility runtime :=
  runtime.accessibility

def publicInitialCertifiedRuntime_reachable :
    CertifiedRuntimeReachable publicDependentIncrementalChecker
      publicInitialCheckedAgent publicInitialCertifiedRuntime :=
  .initial

def publicUpdatedCertifiedRuntime_reachable :
    CertifiedRuntimeReachable publicDependentIncrementalChecker
      publicInitialCheckedAgent publicUpdatedCertifiedRuntime :=
  .submitted publicInitialCertifiedRuntime
    publicUpdatedCertifiedRuntime
    (.reconfigure publicIncrementalNeuralUpdate)
    publicInitialCertifiedRuntime_reachable
    submitUpdate_public_result_exact

def publicUpdatedCertifiedRuntime_accessibility :
    CertifiedRuntimeAccessibility
      publicUpdatedCertifiedRuntime :=
  reachableRuntime_accessibility publicUpdatedCertifiedRuntime
    publicUpdatedCertifiedRuntime_reachable

/-! ## Closed public compatibility API -/

/-- The least family of runtime states obtainable from the public initial
state by successful submissions through the closed API. -/
inductive PublicCertifiedRuntimeReachable : PublicCertifiedRuntime -> Type 5
  | initial : PublicCertifiedRuntimeReachable initialPublicCertifiedRuntime
  | submitted
      (source : PublicCertifiedRuntime)
      (update : IncrementalNeuralUpdate)
      (next : PublicCertifiedRuntime)
      (sourceReachable : PublicCertifiedRuntimeReachable source)
      (accepted : submitPublicUpdate source update = .ok next) :
      PublicCertifiedRuntimeReachable next

/-- Exact accessibility evidence for one runtime.  Both indices are the
runtime projections themselves, so neither the update history nor the final
checked agent can be reconstructed independently. -/
structure PublicCertifiedRuntimeAccessibility
    (runtime : PublicCertifiedRuntime) : Type 5 where
  trace : PublicCheckedReconfigurationTrace publicInitialCheckedAgent
    runtime.updates runtime.current
  everyStep : EveryPublicCheckedStepSatisfies trace

/-- Every state reachable through the closed API carries its exact dependent
checked trace.  The conclusion is stronger than mere trace existence: it also
returns constructive soundness evidence for every stored step. -/
def reachablePublicRuntime_accessibility
    (runtime : PublicCertifiedRuntime)
    (_reachable : PublicCertifiedRuntimeReachable runtime) :
    PublicCertifiedRuntimeAccessibility runtime :=
  { trace := runtime.trace
    everyStep := runtime.everyStep }

def publicInitialPublicCertifiedRuntime_reachable :
    PublicCertifiedRuntimeReachable initialPublicCertifiedRuntime :=
  .initial

def publicUpdatedPublicCertifiedRuntime_reachable :
    PublicCertifiedRuntimeReachable publicUpdatedPublicCertifiedRuntime :=
  .submitted initialPublicCertifiedRuntime publicIncrementalNeuralUpdate
    publicUpdatedPublicCertifiedRuntime publicInitialPublicCertifiedRuntime_reachable
    submitPublicUpdate_result_exact

def publicUpdatedPublicCertifiedRuntime_accessibility :
    PublicCertifiedRuntimeAccessibility publicUpdatedPublicCertifiedRuntime :=
  reachablePublicRuntime_accessibility publicUpdatedPublicCertifiedRuntime
    publicUpdatedPublicCertifiedRuntime_reachable

/-- No state can be added after the public reconfiguration because the fixed
meta-contract admits no outgoing transition from `reconfigured`. -/
theorem publicUpdatedPublicCertifiedRuntime_has_no_successor :
    Not (Exists fun next =>
      submitPublicUpdate publicUpdatedPublicCertifiedRuntime
        publicIncrementalNeuralUpdate = .ok next) := by
  intro accepted
  rcases accepted with ⟨next, exact⟩
  rw [submitPublicUpdate_rejects_unadmitted_second_transition] at exact
  cases exact

end ConstitutiveSearch.NeuralAgent
/- AXIOM_AUDIT_BEGIN -/
#print axioms ConstitutiveSearch.NeuralAgent.CertifiedRuntimeReachable
#print axioms ConstitutiveSearch.NeuralAgent.CertifiedRuntimeAccessibility
#print axioms ConstitutiveSearch.NeuralAgent.CertifiedRuntime.accessibility
#print axioms ConstitutiveSearch.NeuralAgent.reachableRuntime_accessibility
#print axioms ConstitutiveSearch.NeuralAgent.publicUpdatedCertifiedRuntime_reachable
#print axioms ConstitutiveSearch.NeuralAgent.publicUpdatedCertifiedRuntime_accessibility
#print axioms ConstitutiveSearch.NeuralAgent.PublicCertifiedRuntimeReachable
#print axioms ConstitutiveSearch.NeuralAgent.PublicCertifiedRuntimeAccessibility
#print axioms ConstitutiveSearch.NeuralAgent.reachablePublicRuntime_accessibility
#print axioms ConstitutiveSearch.NeuralAgent.publicInitialCertifiedRuntime_reachable
#print axioms ConstitutiveSearch.NeuralAgent.publicInitialPublicCertifiedRuntime_reachable
#print axioms ConstitutiveSearch.NeuralAgent.publicUpdatedPublicCertifiedRuntime_reachable
#print axioms ConstitutiveSearch.NeuralAgent.publicUpdatedPublicCertifiedRuntime_accessibility
#print axioms ConstitutiveSearch.NeuralAgent.publicUpdatedPublicCertifiedRuntime_has_no_successor
/- AXIOM_AUDIT_END -/
