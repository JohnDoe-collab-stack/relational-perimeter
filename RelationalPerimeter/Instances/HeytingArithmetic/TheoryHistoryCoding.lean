import RelationalPerimeter.Instances.HeytingArithmetic.ProofDecoding

/-!
# Positive finite histories of arithmetic theories

The root contains exactly the standard arithmetic schemes.  An extension
stores one additional closed sentence as positive syntax.  No stage number is
carried by the history: its causal predecessor is part of the value itself.

The numerical quotation is a prefix code.  It is used later by the uniform
primitive-recursive proof checker, while `HistoryAxiom` is the typed theory
consumed by object derivations.
-/

namespace RelationalPerimeter
namespace HeytingArithmetic

/-! ## Closed sentences at an arbitrary ambient scope -/

/-- Lift a closed sentence through an explicit number of ambient variables. -/
def Sentence.atBound (sentence : Sentence) :
    (bound : Nat) -> ScopedFormula bound
  | 0 => sentence.scopedFormula
  | Nat.succ bound => (sentence.atBound bound).lift

@[simp] theorem Sentence.atBound_zero (sentence : Sentence) :
    sentence.atBound 0 = sentence.scopedFormula := rfl

@[simp] theorem Sentence.atBound_succ
    (sentence : Sentence)
    (bound : Nat) :
    sentence.atBound (Nat.succ bound) = (sentence.atBound bound).lift := rfl

/-! ## Intrinsic history and positive membership -/

/-- A finite extension history, rooted at standard arithmetic. -/
inductive TheoryHistory : Type
  | root : TheoryHistory
  | extend : TheoryHistory -> Sentence -> TheoryHistory

/-- Positive occurrence of an added sentence in a theory history. -/
inductive TheoryHistory.Contains : Sentence -> TheoryHistory -> Type
  | newest {previous sentence} :
      TheoryHistory.Contains sentence
        (TheoryHistory.extend previous sentence)
  | earlier {previous newest sentence} :
      TheoryHistory.Contains sentence previous ->
      TheoryHistory.Contains sentence
        (TheoryHistory.extend previous newest)

/-- The root has no added sentence. -/
theorem TheoryHistory.rootContainsElim
    {sentence : Sentence} :
    TheoryHistory.Contains sentence TheoryHistory.root -> False
  | evidence => nomatch evidence

/-- Every old postulate remains present after one extension. -/
def TheoryHistory.Contains.preserve
    {history : TheoryHistory}
    {oldSentence newSentence : Sentence}
    (evidence : history.Contains oldSentence) :
    (TheoryHistory.extend history newSentence).Contains oldSentence :=
  TheoryHistory.Contains.earlier evidence

/-! ## Typed theory generated by a history -/

/-- A standard arithmetic postulate or one of the positively stored sentences. -/
inductive HistoryAxiom (history : TheoryHistory) :
    {bound : Nat} -> ScopedFormula bound -> Type
  | arithmetic {bound : Nat} {formula : ScopedFormula bound} :
      StandardArithmeticAxiom formula -> HistoryAxiom history formula
  | added {bound : Nat} {sentence : Sentence} :
      history.Contains sentence ->
      HistoryAxiom history (sentence.atBound bound)

/-- Every old theory postulate remains an postulate after one intrinsic extension. -/
def HistoryAxiom.preserve
    {history : TheoryHistory}
    {newest : Sentence}
    {bound : Nat}
    {formula : ScopedFormula bound} :
    HistoryAxiom history formula ->
      HistoryAxiom (TheoryHistory.extend history newest) formula
  | HistoryAxiom.arithmetic witness => HistoryAxiom.arithmetic witness
  | HistoryAxiom.added evidence =>
      HistoryAxiom.added evidence.preserve

/-- The arithmetic theory determined by one finite history. -/
def TheoryHistory.theory (history : TheoryHistory) : ArithmeticTheory :=
  { Axiom := fun _bound formula => HistoryAxiom history formula }

/-- A history-relative derivability proposition. -/
def HistoryProvable
    (history : TheoryHistory)
    (sentence : Sentence) : Prop :=
  TheoryProvable LogicMode.intuitionistic history.theory sentence

/-- The root history is the standard arithmetic theory, extensionally at the
    level of positive postulate witnesses. -/
def rootAxiomToStandard
    {bound : Nat}
    {formula : ScopedFormula bound} :
    HistoryAxiom TheoryHistory.root formula ->
      StandardArithmeticAxiom formula
  | HistoryAxiom.arithmetic witness => witness
  | HistoryAxiom.added evidence =>
      False.elim (TheoryHistory.rootContainsElim evidence)

/-- Every standard arithmetic postulate is a root-history postulate. -/
def standardAxiomToRoot
    {bound : Nat}
    {formula : ScopedFormula bound}
    (witness : StandardArithmeticAxiom formula) :
    HistoryAxiom TheoryHistory.root formula :=
  HistoryAxiom.arithmetic witness

/-! ## Constructive quotation and decoding -/

/-- Prefix quotation: zero is the root, and every extension stores its newest
    sentence code together with the predecessor quotation. -/
def TheoryHistory.quote : TheoryHistory -> Nat
  | TheoryHistory.root => 0
  | TheoryHistory.extend previous sentence =>
      Nat.succ (natPair sentence.quote previous.quote)

/-- Decode a closed sentence, recomputing its scoping certificate. -/
def decodeSentence (code : Nat) : Option Sentence := do
  let formula <- decodeScopedFormula 0 code
  pure { raw := formula.raw, isScoped := formula.isScoped }

theorem decodeSentence_quote (sentence : Sentence) :
    decodeSentence sentence.quote = some sentence := by
  unfold decodeSentence Sentence.quote
  have decoded : decodeScopedFormula 0 sentence.raw.code =
      some sentence.scopedFormula :=
    decodeScopedFormula_code sentence.scopedFormula
  rw [decoded]
  rfl

/-- Fuelled decoder for prefix-coded theory histories. -/
def decodeTheoryHistoryFuel : Nat -> Nat -> Option TheoryHistory
  | 0, 0 => some TheoryHistory.root
  | 0, Nat.succ _code => none
  | Nat.succ _fuel, 0 => some TheoryHistory.root
  | Nat.succ fuel, Nat.succ code => do
      let components := natUnpair code
      let sentence <- decodeSentence components.1
      let previous <- decodeTheoryHistoryFuel fuel components.2
      pure (TheoryHistory.extend previous sentence)

/-- Total decoder whose code itself supplies sufficient fuel. -/
def decodeTheoryHistory (code : Nat) : Option TheoryHistory :=
  decodeTheoryHistoryFuel code code

theorem decodeTheoryHistoryFuel_quote
    (history : TheoryHistory)
    (fuel : Nat)
    (bounded : history.quote <= fuel) :
    decodeTheoryHistoryFuel fuel history.quote = some history := by
  induction history generalizing fuel with
  | root =>
      cases fuel <;> rfl
  | extend previous sentence inductionHypothesis =>
      cases fuel with
      | zero => exact (Nat.not_succ_le_zero _ bounded).elim
      | succ fuel =>
          have previousBound : previous.quote <= fuel := by
            have pairedBound :
                natPair sentence.quote previous.quote <= fuel :=
              Nat.le_of_succ_le_succ bounded
            exact Nat.le_trans
              (natPair_right_le sentence.quote previous.quote) pairedBound
          rw [TheoryHistory.quote, decodeTheoryHistoryFuel, natUnpair_pair,
            decodeSentence_quote, inductionHypothesis fuel previousBound]
          rfl

theorem decodeTheoryHistory_quote (history : TheoryHistory) :
    decodeTheoryHistory history.quote = some history :=
  decodeTheoryHistoryFuel_quote history history.quote
    (Nat.le_refl history.quote)

/-- Equality of history quotations determines equality of histories. -/
theorem TheoryHistory.eq_of_quote_eq
    {left right : TheoryHistory}
    (sameQuote : left.quote = right.quote) : left = right := by
  have leftDecoded := decodeTheoryHistory_quote left
  have rightDecoded := decodeTheoryHistory_quote right
  rw [sameQuote] at leftDecoded
  rw [leftDecoded] at rightDecoded
  exact Option.some.inj rightDecoded

end HeytingArithmetic
end RelationalPerimeter

