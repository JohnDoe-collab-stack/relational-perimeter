import RelationalPerimeter.Instances.HeytingArithmetic.PrimitiveRecursiveSyntaxTrace

/-!
# Correctness of strict canonical-syntax recognition

The course-of-values trace accepts exactly the injective codes generated by
`RawTerm.code` and `RawFormula.code`.  This file first proves the constructive
forward direction on typed syntax, then reconstructs typed syntax from every
positive recognition result.
-/

namespace RelationalPerimeter
namespace HeytingArithmetic

private theorem child_left_lt_binary
    (tag left right : Nat) :
    left < Nat.succ (natPair tag (natPair left right)) :=
  Nat.lt_succ_of_le
    (Nat.le_trans (natPair_left_le left right)
      (natPair_right_le tag (natPair left right)))

private theorem child_right_lt_binary
    (tag left right : Nat) :
    right < Nat.succ (natPair tag (natPair left right)) :=
  Nat.lt_succ_of_le
    (Nat.le_trans (natPair_right_le left right)
      (natPair_right_le tag (natPair left right)))

private theorem termBit_bvar (index : Nat) :
    natUnpairLeft (syntaxEntryAt (RawTerm.bvar index).code) = 1 := by
  unfold RawTerm.code
  rw [syntaxEntryAt]
  unfold PRFunction.syntaxEntry
  rw [PRFunction.run_binaryIn, PRFunction.run_pair,
    natUnpairLeft_pair]
  unfold PRFunction.syntaxTermBitAt
  rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
    natUnpairLeft_pair]
  rfl

private theorem termBit_zero :
    natUnpairLeft (syntaxEntryAt RawTerm.zero.code) = 1 := by
  unfold RawTerm.code
  rw [syntaxEntryAt]
  unfold PRFunction.syntaxEntry
  rw [PRFunction.run_binaryIn, PRFunction.run_pair,
    natUnpairLeft_pair]
  unfold PRFunction.syntaxTermBitAt
  rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
    natUnpairLeft_pair]
  rw [show natEqualBit 1 0 = 0 by rfl]
  rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
    natUnpairLeft_pair, PRFunction.run_binaryIn,
    PRFunction.run_syntaxCurrentPayload, natUnpairRight_pair,
    PRFunction.run_constant, PRFunction.run_equalBit]
  rfl

private theorem termBit_succ
    (body : RawTerm)
    (accepted : natUnpairLeft (syntaxEntryAt body.code) = 1) :
    natUnpairLeft (syntaxEntryAt (RawTerm.succ body).code) = 1 := by
  have earlier : body.code < (RawTerm.succ body).code :=
    Nat.lt_succ_of_le (natPair_right_le 2 body.code)
  have lookup := syntaxTermLookupCode_current
    (RawTerm.succ body).code body.code body.code_pos earlier
  change natUnpairLeft
      (natTraceLookupCode (Nat.succ (natPair 2 body.code)) body.code
        (syntaxTraceValue (natPair 2 body.code))) =
    natUnpairLeft (syntaxEntryAt body.code) at lookup
  unfold RawTerm.code
  rw [syntaxEntryAt]
  unfold PRFunction.syntaxEntry
  rw [PRFunction.run_binaryIn, PRFunction.run_pair,
    natUnpairLeft_pair]
  unfold PRFunction.syntaxTermBitAt
  rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
    natUnpairLeft_pair]
  rw [show natEqualBit 2 0 = 0 by rfl]
  rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
    natUnpairLeft_pair]
  rw [show natEqualBit 2 1 = 0 by rfl]
  rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
    natUnpairLeft_pair]
  rw [show natEqualBit 2 2 = 1 by rfl]
  rw [PRFunction.run_syntaxTermLookup,
    PRFunction.run_syntaxCurrentPayload, natUnpairRight_pair]
  exact lookup.trans accepted

private theorem termBit_binary
    (tag : Nat)
    (tagIsThreeOrFour : tag = 3 \/ tag = 4)
    (left right : RawTerm)
    (leftAccepted : natUnpairLeft (syntaxEntryAt left.code) = 1)
    (rightAccepted : natUnpairLeft (syntaxEntryAt right.code) = 1) :
    natUnpairLeft
        (syntaxEntryAt
          (Nat.succ (natPair tag (natPair left.code right.code)))) = 1 := by
  have leftEarlier := child_left_lt_binary tag left.code right.code
  have rightEarlier := child_right_lt_binary tag left.code right.code
  have leftLookup := syntaxTermLookupCode_current
    (Nat.succ (natPair tag (natPair left.code right.code)))
    left.code left.code_pos leftEarlier
  have rightLookup := syntaxTermLookupCode_current
    (Nat.succ (natPair tag (natPair left.code right.code)))
    right.code right.code_pos rightEarlier
  rw [Nat.pred_succ] at leftLookup rightLookup
  cases tagIsThreeOrFour with
  | inl tagThree =>
      subst tag
      rw [syntaxEntryAt]
      unfold PRFunction.syntaxEntry
      rw [PRFunction.run_binaryIn, PRFunction.run_pair,
        natUnpairLeft_pair]
      unfold PRFunction.syntaxTermBitAt
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 3 0 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 3 1 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 3 2 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 3 3 = 1 by rfl]
      rw [PRFunction.run_syntaxBoth]
      repeat rw [PRFunction.run_syntaxTermLookup]
      repeat rw [PRFunction.run_syntaxCurrentLeft]
      repeat rw [PRFunction.run_syntaxCurrentRight]
      rw [natUnpairRight_pair, natUnpairLeft_pair, natUnpairRight_pair,
        leftLookup, rightLookup, leftAccepted, rightAccepted]
      rfl
  | inr tagFour =>
      subst tag
      rw [syntaxEntryAt]
      unfold PRFunction.syntaxEntry
      rw [PRFunction.run_binaryIn, PRFunction.run_pair,
        natUnpairLeft_pair]
      unfold PRFunction.syntaxTermBitAt
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 4 0 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 4 1 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 4 2 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 4 3 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 4 4 = 1 by rfl]
      rw [PRFunction.run_syntaxBoth]
      repeat rw [PRFunction.run_syntaxTermLookup]
      repeat rw [PRFunction.run_syntaxCurrentLeft]
      repeat rw [PRFunction.run_syntaxCurrentRight]
      rw [natUnpairRight_pair, natUnpairLeft_pair, natUnpairRight_pair,
        leftLookup, rightLookup, leftAccepted, rightAccepted]
      rfl

theorem RawTerm.strictCode_accepts (term : RawTerm) :
    natUnpairLeft (syntaxEntryAt term.code) = 1 := by
  induction term with
  | bvar index => exact termBit_bvar index
  | zero => exact termBit_zero
  | succ body inductionHypothesis => exact termBit_succ body inductionHypothesis
  | add left right leftHypothesis rightHypothesis =>
      exact termBit_binary 3 (Or.inl rfl) left right
        leftHypothesis rightHypothesis
  | mul left right leftHypothesis rightHypothesis =>
      exact termBit_binary 4 (Or.inr rfl) left right
        leftHypothesis rightHypothesis

private theorem formulaBit_falsum :
    natUnpairRight (syntaxEntryAt RawFormula.falsum.code) = 1 := by
  unfold RawFormula.code
  rw [syntaxEntryAt]
  unfold PRFunction.syntaxEntry
  rw [PRFunction.run_binaryIn, PRFunction.run_pair,
    natUnpairRight_pair]
  unfold PRFunction.syntaxFormulaBitAt
  rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
    natUnpairLeft_pair, PRFunction.run_binaryIn,
    PRFunction.run_syntaxCurrentPayload, natUnpairRight_pair,
    PRFunction.run_constant, PRFunction.run_equalBit]
  rfl

private theorem formulaBit_equal (left right : RawTerm) :
    natUnpairRight
      (syntaxEntryAt (RawFormula.equal left right).code) = 1 := by
  have leftEarlier := child_left_lt_binary 1 left.code right.code
  have rightEarlier := child_right_lt_binary 1 left.code right.code
  have leftLookup := syntaxTermLookupCode_current
    (RawFormula.equal left right).code left.code left.code_pos leftEarlier
  have rightLookup := syntaxTermLookupCode_current
    (RawFormula.equal left right).code right.code right.code_pos rightEarlier
  change natUnpairLeft
      (natTraceLookupCode
        (Nat.succ (natPair 1 (natPair left.code right.code))) left.code
        (syntaxTraceValue (natPair 1 (natPair left.code right.code)))) =
    natUnpairLeft (syntaxEntryAt left.code) at leftLookup
  change natUnpairLeft
      (natTraceLookupCode
        (Nat.succ (natPair 1 (natPair left.code right.code))) right.code
        (syntaxTraceValue (natPair 1 (natPair left.code right.code)))) =
    natUnpairLeft (syntaxEntryAt right.code) at rightLookup
  unfold RawFormula.code
  rw [syntaxEntryAt]
  unfold PRFunction.syntaxEntry
  rw [PRFunction.run_binaryIn, PRFunction.run_pair,
    natUnpairRight_pair]
  unfold PRFunction.syntaxFormulaBitAt
  rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
    natUnpairLeft_pair]
  rw [show natEqualBit 1 0 = 0 by rfl]
  rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
    natUnpairLeft_pair]
  rw [show natEqualBit 1 1 = 1 by rfl]
  rw [PRFunction.run_syntaxBoth]
  repeat rw [PRFunction.run_syntaxTermLookup]
  repeat rw [PRFunction.run_syntaxCurrentLeft]
  repeat rw [PRFunction.run_syntaxCurrentRight]
  rw [natUnpairRight_pair, natUnpairLeft_pair, natUnpairRight_pair,
    leftLookup, rightLookup, left.strictCode_accepts,
    right.strictCode_accepts]
  rfl

private theorem formulaBit_binary
    (tag : Nat)
    (tagCase : tag = 2 \/ tag = 3 \/ tag = 4)
    (left right : RawFormula)
    (leftAccepted : natUnpairRight (syntaxEntryAt left.code) = 1)
    (rightAccepted : natUnpairRight (syntaxEntryAt right.code) = 1) :
    natUnpairRight
      (syntaxEntryAt
        (Nat.succ (natPair tag (natPair left.code right.code)))) = 1 := by
  have leftEarlier := child_left_lt_binary tag left.code right.code
  have rightEarlier := child_right_lt_binary tag left.code right.code
  have leftLookup := syntaxFormulaLookupCode_current
    (Nat.succ (natPair tag (natPair left.code right.code)))
    left.code left.code_pos leftEarlier
  have rightLookup := syntaxFormulaLookupCode_current
    (Nat.succ (natPair tag (natPair left.code right.code)))
    right.code right.code_pos rightEarlier
  rw [Nat.pred_succ] at leftLookup rightLookup
  cases tagCase with
  | inl tagTwo =>
      subst tag
      rw [syntaxEntryAt]
      unfold PRFunction.syntaxEntry
      rw [PRFunction.run_binaryIn, PRFunction.run_pair,
        natUnpairRight_pair]
      unfold PRFunction.syntaxFormulaBitAt
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 2 0 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 2 1 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 2 2 = 1 by rfl]
      rw [PRFunction.run_syntaxBoth]
      repeat rw [PRFunction.run_syntaxFormulaLookup]
      repeat rw [PRFunction.run_syntaxCurrentLeft]
      repeat rw [PRFunction.run_syntaxCurrentRight]
      rw [natUnpairRight_pair, natUnpairLeft_pair, natUnpairRight_pair,
        leftLookup, rightLookup, leftAccepted, rightAccepted]
      rfl
  | inr remaining =>
      cases remaining with
      | inl tagThree =>
          subst tag
          rw [syntaxEntryAt]
          unfold PRFunction.syntaxEntry
          rw [PRFunction.run_binaryIn, PRFunction.run_pair,
            natUnpairRight_pair]
          unfold PRFunction.syntaxFormulaBitAt
          rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
            natUnpairLeft_pair]
          rw [show natEqualBit 3 0 = 0 by rfl]
          rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
            natUnpairLeft_pair]
          rw [show natEqualBit 3 1 = 0 by rfl]
          rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
            natUnpairLeft_pair]
          rw [show natEqualBit 3 2 = 0 by rfl]
          rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
            natUnpairLeft_pair]
          rw [show natEqualBit 3 3 = 1 by rfl]
          rw [PRFunction.run_syntaxBoth]
          repeat rw [PRFunction.run_syntaxFormulaLookup]
          repeat rw [PRFunction.run_syntaxCurrentLeft]
          repeat rw [PRFunction.run_syntaxCurrentRight]
          rw [natUnpairRight_pair, natUnpairLeft_pair, natUnpairRight_pair,
            leftLookup, rightLookup, leftAccepted, rightAccepted]
          rfl
      | inr tagFour =>
          subst tag
          rw [syntaxEntryAt]
          unfold PRFunction.syntaxEntry
          rw [PRFunction.run_binaryIn, PRFunction.run_pair,
            natUnpairRight_pair]
          unfold PRFunction.syntaxFormulaBitAt
          rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
            natUnpairLeft_pair]
          rw [show natEqualBit 4 0 = 0 by rfl]
          rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
            natUnpairLeft_pair]
          rw [show natEqualBit 4 1 = 0 by rfl]
          rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
            natUnpairLeft_pair]
          rw [show natEqualBit 4 2 = 0 by rfl]
          rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
            natUnpairLeft_pair]
          rw [show natEqualBit 4 3 = 0 by rfl]
          rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
            natUnpairLeft_pair]
          rw [show natEqualBit 4 4 = 1 by rfl]
          rw [PRFunction.run_syntaxBoth]
          repeat rw [PRFunction.run_syntaxFormulaLookup]
          repeat rw [PRFunction.run_syntaxCurrentLeft]
          repeat rw [PRFunction.run_syntaxCurrentRight]
          rw [natUnpairRight_pair, natUnpairLeft_pair, natUnpairRight_pair,
            leftLookup, rightLookup, leftAccepted, rightAccepted]
          rfl

private theorem formulaBit_quantifier
    (tag : Nat)
    (tagCase : tag = 5 \/ tag = 6)
    (body : RawFormula)
    (accepted : natUnpairRight (syntaxEntryAt body.code) = 1) :
    natUnpairRight
      (syntaxEntryAt (Nat.succ (natPair tag body.code))) = 1 := by
  have earlier : body.code < Nat.succ (natPair tag body.code) :=
    Nat.lt_succ_of_le (natPair_right_le tag body.code)
  have lookup := syntaxFormulaLookupCode_current
    (Nat.succ (natPair tag body.code)) body.code body.code_pos earlier
  rw [Nat.pred_succ] at lookup
  cases tagCase with
  | inl tagFive =>
      subst tag
      rw [syntaxEntryAt]
      unfold PRFunction.syntaxEntry
      rw [PRFunction.run_binaryIn, PRFunction.run_pair,
        natUnpairRight_pair]
      unfold PRFunction.syntaxFormulaBitAt
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 5 0 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 5 1 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 5 2 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 5 3 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 5 4 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 5 5 = 1 by rfl]
      rw [PRFunction.run_syntaxFormulaLookup,
        PRFunction.run_syntaxCurrentPayload, natUnpairRight_pair,
        lookup, accepted]
      rfl
  | inr tagSix =>
      subst tag
      rw [syntaxEntryAt]
      unfold PRFunction.syntaxEntry
      rw [PRFunction.run_binaryIn, PRFunction.run_pair,
        natUnpairRight_pair]
      unfold PRFunction.syntaxFormulaBitAt
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 6 0 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 6 1 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 6 2 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 6 3 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 6 4 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 6 5 = 0 by rfl]
      rw [PRFunction.run_selectTag, PRFunction.run_syntaxCurrentTag,
        natUnpairLeft_pair]
      rw [show natEqualBit 6 6 = 1 by rfl]
      rw [PRFunction.run_syntaxFormulaLookup,
        PRFunction.run_syntaxCurrentPayload, natUnpairRight_pair,
        lookup, accepted]
      rfl

theorem RawFormula.strictCode_accepts (formula : RawFormula) :
    natUnpairRight (syntaxEntryAt formula.code) = 1 := by
  induction formula with
  | falsum => exact formulaBit_falsum
  | equal left right => exact formulaBit_equal left right
  | conj left right leftHypothesis rightHypothesis =>
      exact formulaBit_binary 2 (Or.inl rfl) left right
        leftHypothesis rightHypothesis
  | disj left right leftHypothesis rightHypothesis =>
      exact formulaBit_binary 3 (Or.inr (Or.inl rfl)) left right
        leftHypothesis rightHypothesis
  | impl left right leftHypothesis rightHypothesis =>
      exact formulaBit_binary 4 (Or.inr (Or.inr rfl)) left right
        leftHypothesis rightHypothesis
  | all body inductionHypothesis =>
      exact formulaBit_quantifier 5 (Or.inl rfl) body inductionHypothesis
  | ex body inductionHypothesis =>
      exact formulaBit_quantifier 6 (Or.inr rfl) body inductionHypothesis

/-! ## Reconstruction from an accepted term bit -/

private theorem syntaxIfZero_zero (whenZero whenPositive : Nat) :
    natIfZero 0 whenZero whenPositive = whenZero := rfl

private theorem syntaxIfZero_succ
    (value whenZero whenPositive : Nat) :
    natIfZero (Nat.succ value) whenZero whenPositive = whenPositive := rfl

private theorem syntaxEqual_zero_zero : natEqualBit 0 0 = 1 := rfl

private theorem syntaxTraceValue_lookupBeyond (counter : Nat) :
    natTraceLookup counter (syntaxTraceValue counter) = 0 := by
  induction counter with
  | zero => rfl
  | succ counter inductionHypothesis =>
      rw [syntaxTraceValue_succ, natTraceLookup_succ_pair]
      exact inductionHypothesis

private theorem syntaxTraceLookupCode_zero (current : Nat) :
    natTraceLookupCode current 0 (syntaxTraceValue current.pred) = 0 := by
  cases current with
  | zero => rfl
  | succ previous =>
      unfold natTraceLookupCode
      rw [Nat.sub_zero, Nat.pred_succ]
      exact syntaxTraceValue_lookupBeyond previous

macro "normalize_term_acceptance_at"
    hypothesis:Lean.Parser.Tactic.locationHyp : tactic =>
  `(tactic|
    repeat first
      | rw [syntaxEntryAt] at $hypothesis
      | rw [PRFunction.run_syntaxEntry] at $hypothesis
      | rw [natUnpairLeft_pair] at $hypothesis
      | unfold PRFunction.syntaxTermBitAt at $hypothesis
      | rw [PRFunction.run_selectTag] at $hypothesis
      | rw [PRFunction.run_syntaxCurrentTag] at $hypothesis
      | rw [PRFunction.run_syntaxCurrentPayload] at $hypothesis
      | rw [PRFunction.run_syntaxCurrentLeft] at $hypothesis
      | rw [PRFunction.run_syntaxCurrentRight] at $hypothesis
      | rw [PRFunction.run_syntaxBoth] at $hypothesis
      | rw [PRFunction.run_syntaxTermLookup] at $hypothesis
      | rw [PRFunction.run_binaryIn] at $hypothesis
      | rw [PRFunction.run_equalBit] at $hypothesis
      | rw [PRFunction.run_constant] at $hypothesis
      | rw [natUnpairLeft_pair] at $hypothesis
      | rw [natUnpairRight_pair] at $hypothesis
      | rw [natEqualBit_succ_succ] at $hypothesis
      | rw [natEqualBit_succ_zero] at $hypothesis
      | rw [syntaxEqual_zero_zero] at $hypothesis
      | rw [syntaxIfZero_zero] at $hypothesis
      | rw [syntaxIfZero_succ] at $hypothesis)

macro "normalize_formula_acceptance_at"
    hypothesis:Lean.Parser.Tactic.locationHyp : tactic =>
  `(tactic|
    repeat first
      | rw [syntaxEntryAt] at $hypothesis
      | rw [PRFunction.run_syntaxEntry] at $hypothesis
      | rw [natUnpairRight_pair] at $hypothesis
      | unfold PRFunction.syntaxFormulaBitAt at $hypothesis
      | rw [PRFunction.run_selectTag] at $hypothesis
      | rw [PRFunction.run_syntaxCurrentTag] at $hypothesis
      | rw [PRFunction.run_syntaxCurrentPayload] at $hypothesis
      | rw [PRFunction.run_syntaxCurrentLeft] at $hypothesis
      | rw [PRFunction.run_syntaxCurrentRight] at $hypothesis
      | rw [PRFunction.run_syntaxBoth] at $hypothesis
      | rw [PRFunction.run_syntaxTermLookup] at $hypothesis
      | rw [PRFunction.run_syntaxFormulaLookup] at $hypothesis
      | rw [PRFunction.run_binaryIn] at $hypothesis
      | rw [PRFunction.run_equalBit] at $hypothesis
      | rw [PRFunction.run_constant] at $hypothesis
      | rw [natUnpairLeft_pair] at $hypothesis
      | rw [natUnpairRight_pair] at $hypothesis
      | rw [natEqualBit_succ_succ] at $hypothesis
      | rw [natEqualBit_succ_zero] at $hypothesis
      | rw [syntaxEqual_zero_zero] at $hypothesis
      | rw [syntaxIfZero_zero] at $hypothesis
      | rw [syntaxIfZero_succ] at $hypothesis)

/- The original equality-based reconstruction is retained below as design
history.  The compiled proof uses positivity as its induction invariant: the
binary recognizer tests positivity, so positivity is the exact information
transported from a parent entry to its children.
theorem strictTermCode_sound
    (code : Nat)
    (accepted : natUnpairLeft (syntaxEntryAt code) = 1) :
    Exists fun term : RawTerm => term.code = code := by
  induction code using Nat.strongRecOn with
  | ind code inductionHypothesis =>
      cases code with
      | zero =>
          rw [syntaxEntryAt] at accepted
          exact Nat.noConfusion accepted
      | succ encoded =>
          cases natPair_surjective encoded with
          | intro components decomposition =>
              cases components with
              | mk tag payload =>
                  subst encoded
                  cases tag with
                  | zero =>
                      exact Exists.intro (RawTerm.bvar payload) rfl
                  | succ tag =>
                      cases tag with
                      | zero =>
                          have canonical : natEqualBit payload 0 = 1 := by
                            simpa [syntaxEntryAt, PRFunction.syntaxEntry,
                              PRFunction.syntaxTermBitAt, natIfZero]
                              using accepted
                          have payloadZero :=
                            (natEqualBit_eq_one_iff payload 0).mp canonical
                          subst payload
                          exact Exists.intro RawTerm.zero rfl
                      | succ tag =>
                          cases tag with
                          | zero =>
                              have childPositive : 0 < payload := by
                                cases payload with
                                | zero =>
                                    simp [syntaxEntryAt,
                                      PRFunction.syntaxEntry,
                                      PRFunction.syntaxTermBitAt,
                                      PRFunction.syntaxLookup,
                                      natTraceLookupCode, natIfZero]
                                      at accepted
                                | succ payload => exact Nat.zero_lt_succ payload
                              have childEarlier :
                                  payload < Nat.succ (natPair 2 payload) :=
                                Nat.lt_succ_of_le
                                  (natPair_right_le 2 payload)
                              have childAccepted :
                                  natUnpairLeft (syntaxEntryAt payload) = 1 := by
                                have lookup := syntaxTermLookupCode_current
                                  (Nat.succ (natPair 2 payload)) payload
                                  childPositive childEarlier
                                have selected :
                                    natUnpairLeft
                                      (natTraceLookupCode
                                        (Nat.succ (natPair 2 payload)) payload
                                        (syntaxTraceValue
                                          (natPair 2 payload))) = 1 := by
                                  simpa [syntaxEntryAt,
                                    PRFunction.syntaxEntry,
                                    PRFunction.syntaxTermBitAt, natIfZero]
                                    using accepted
                                exact lookup.symm.trans selected
                              cases inductionHypothesis payload childEarlier
                                  childAccepted with
                              | intro body bodyCode =>
                                  exact Exists.intro (RawTerm.succ body) (by
                                    rw [RawTerm.code, bodyCode])
                          | succ tag =>
                              cases tag with
                              | zero =>
                                  have bothPositive :
                                      0 < natUnpairLeft payload ∧
                                        0 < natUnpairRight payload := by
                                    apply (natAndBit_eq_one_iff _ _).mp
                                    simpa [syntaxEntryAt,
                                      PRFunction.syntaxEntry,
                                      PRFunction.syntaxTermBitAt, natIfZero]
                                      using accepted
