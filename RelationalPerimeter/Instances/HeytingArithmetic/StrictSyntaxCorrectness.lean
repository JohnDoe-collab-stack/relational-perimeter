    cases right : natUnpairRight payload with
    | zero =>
        rw [right] at selected
        simp [natTraceLookupCode, natIfZero] at selected
    | succ right => exact Nat.zero_lt_succ right
  have leftEarlier : natUnpairLeft payload < current := by
    rw [currentCode, ← natPair_unpairLeft_unpairRight payload]
    exact child_left_lt_binary tag _ _
  have rightEarlier : natUnpairRight payload < current := by
    rw [currentCode, ← natPair_unpairLeft_unpairRight payload]
    exact child_right_lt_binary tag _ _
  have leftLookup := syntaxFormulaLookupCode_current current
    (natUnpairLeft payload) leftPositive leftEarlier
  have rightLookup := syntaxFormulaLookupCode_current current
    (natUnpairRight payload) rightPositive rightEarlier
  have leftAccepted :
      natUnpairRight (syntaxEntryAt (natUnpairLeft payload)) = 1 :=
    (natPositiveBit_eq_one_iff _).mpr
      (leftLookup.symm ▸ lookupPositive.1)
  have rightAccepted :
      natUnpairRight (syntaxEntryAt (natUnpairRight payload)) = 1 :=
    (natPositiveBit_eq_one_iff _).mpr
      (rightLookup.symm ▸ lookupPositive.2)
  cases reconstruct _ leftEarlier leftAccepted with
  | intro left leftCode =>
      cases reconstruct _ rightEarlier rightAccepted with
      | intro right rightCode =>
          exact Exists.intro (left, right)
            (And.intro leftCode rightCode)

theorem strictFormulaCode_sound
    (code : Nat)
    (accepted : natUnpairRight (syntaxEntryAt code) = 1) :
    Exists fun formula : RawFormula => formula.code = code := by
  induction code using Nat.strongRecOn with
  | ind code inductionHypothesis =>
      cases code with
      | zero =>
          rw [syntaxEntryAt] at accepted
          exact Nat.noConfusion accepted
      | succ encoded =>
          cases natPair_surjective encoded with
          | intro components decomposition =>
              cases components with
              | mk tag payload =>
                  subst encoded
                  cases tag with
                  | zero =>
                      have canonical : natEqualBit payload 0 = 1 := by
                        simpa [syntaxEntryAt, PRFunction.syntaxEntry,
                          PRFunction.syntaxFormulaBitAt, natIfZero]
                          using accepted
                      have payloadZero :=
                        (natEqualBit_eq_one_iff payload 0).mp canonical
                      subst payload
                      exact Exists.intro RawFormula.falsum rfl
                  | succ tag =>
                      cases tag with
                      | zero =>
                          have selected :
                              natAndBit
                                (natUnpairLeft
                                  (natTraceLookupCode
                                    (Nat.succ (natPair 1 payload))
                                    (natUnpairLeft payload)
                                    (syntaxTraceValue (natPair 1 payload))))
                                (natUnpairLeft
                                  (natTraceLookupCode
                                    (Nat.succ (natPair 1 payload))
                                    (natUnpairRight payload)
                                    (syntaxTraceValue (natPair 1 payload)))) = 1 := by
                            simpa [syntaxEntryAt, PRFunction.syntaxEntry,
                              PRFunction.syntaxFormulaBitAt, natIfZero]
                              using accepted
                          cases strictTermPair_sound 1 payload selected with
                          | intro terms termCodes =>
                              exact Exists.intro
                                (RawFormula.equal terms.1 terms.2) (by
                                  rw [RawFormula.code, termCodes.1,
                                    termCodes.2,
                                    natPair_unpairLeft_unpairRight])
                      | succ tag =>
                          cases tag with
                          | zero =>
                              have selected :
                                  natAndBit
                                    (natUnpairRight
                                      (natTraceLookupCode
                                        (Nat.succ (natPair 2 payload))
                                        (natUnpairLeft payload)
                                        (syntaxTraceValue (natPair 2 payload))))
                                    (natUnpairRight
                                      (natTraceLookupCode
                                        (Nat.succ (natPair 2 payload))
                                        (natUnpairRight payload)
                                        (syntaxTraceValue (natPair 2 payload)))) = 1 := by
                                simpa [syntaxEntryAt,
                                  PRFunction.syntaxEntry,
                                  PRFunction.syntaxFormulaBitAt, natIfZero]
                                  using accepted
                              cases strictFormulaPair_sound
                                  (Nat.succ (natPair 2 payload)) 2 payload rfl
                                  selected inductionHypothesis with
                              | intro formulas codes =>
                                  exact Exists.intro
                                    (RawFormula.conj formulas.1 formulas.2) (by
                                      rw [RawFormula.code, codes.1, codes.2,
                                        natPair_unpairLeft_unpairRight])
                          | succ tag =>
                              cases tag with
                              | zero =>
                                  have selected :
                                      natAndBit
                                        (natUnpairRight
                                          (natTraceLookupCode
                                            (Nat.succ (natPair 3 payload))
                                            (natUnpairLeft payload)
                                            (syntaxTraceValue
                                              (natPair 3 payload))))
                                        (natUnpairRight
                                          (natTraceLookupCode
                                            (Nat.succ (natPair 3 payload))
                                            (natUnpairRight payload)
                                            (syntaxTraceValue
                                              (natPair 3 payload)))) = 1 := by
                                    simpa [syntaxEntryAt,
                                      PRFunction.syntaxEntry,
                                      PRFunction.syntaxFormulaBitAt, natIfZero]
                                      using accepted
                                  cases strictFormulaPair_sound
                                      (Nat.succ (natPair 3 payload)) 3 payload
                                      rfl selected inductionHypothesis with
                                  | intro formulas codes =>
                                      exact Exists.intro
                                        (RawFormula.disj formulas.1 formulas.2)
                                        (by
                                          rw [RawFormula.code, codes.1,
                                            codes.2,
                                            natPair_unpairLeft_unpairRight])
                              | succ tag =>
                                  cases tag with
                                  | zero =>
                                      have selected :
                                          natAndBit
                                            (natUnpairRight
                                              (natTraceLookupCode
                                                (Nat.succ (natPair 4 payload))
                                                (natUnpairLeft payload)
                                                (syntaxTraceValue
                                                  (natPair 4 payload))))
                                            (natUnpairRight
                                              (natTraceLookupCode
                                                (Nat.succ (natPair 4 payload))
                                                (natUnpairRight payload)
                                                (syntaxTraceValue
                                                  (natPair 4 payload)))) = 1 := by
                                        simpa [syntaxEntryAt,
                                          PRFunction.syntaxEntry,
                                          PRFunction.syntaxFormulaBitAt,
                                          natIfZero] using accepted
                                      cases strictFormulaPair_sound
                                          (Nat.succ (natPair 4 payload)) 4
                                          payload rfl selected
                                          inductionHypothesis with
                                      | intro formulas codes =>
                                          exact Exists.intro
                                            (RawFormula.impl
                                              formulas.1 formulas.2) (by
                                                rw [RawFormula.code, codes.1,
                                                  codes.2,
                                                  natPair_unpairLeft_unpairRight])
                                  | succ tag =>
                                      cases tag with
                                      | zero =>
                                          have childPositive : 0 < payload := by
                                            cases payload with
                                            | zero =>
                                                simp [syntaxEntryAt,
                                                  PRFunction.syntaxEntry,
                                                  PRFunction.syntaxFormulaBitAt,
                                                  PRFunction.syntaxLookup,
                                                  natTraceLookupCode,
                                                  natIfZero] at accepted
                                            | succ payload =>
                                                exact Nat.zero_lt_succ payload
                                          have childEarlier :
                                              payload <
                                                Nat.succ (natPair 5 payload) :=
                                            Nat.lt_succ_of_le
                                              (natPair_right_le 5 payload)
                                          have lookup :=
                                            syntaxFormulaLookupCode_current
                                              (Nat.succ (natPair 5 payload))
                                              payload childPositive childEarlier
                                          have selected :
                                              natUnpairRight
                                                (natTraceLookupCode
                                                  (Nat.succ
                                                    (natPair 5 payload))
                                                  payload
                                                  (syntaxTraceValue
                                                    (natPair 5 payload))) = 1 := by
                                            simpa [syntaxEntryAt,
                                              PRFunction.syntaxEntry,
                                              PRFunction.syntaxFormulaBitAt,
                                              natIfZero] using accepted
                                          have childAccepted :=
                                            lookup.symm.trans selected
                                          cases inductionHypothesis payload
                                              childEarlier childAccepted with
                                          | intro body bodyCode =>
                                              exact Exists.intro
                                                (RawFormula.all body) (by
                                                  rw [RawFormula.code,
                                                    bodyCode])
                                      | succ tag =>
                                          cases tag with
                                          | zero =>
                                              have childPositive :
                                                  0 < payload := by
                                                cases payload with
                                                | zero =>
                                                    simp [syntaxEntryAt,
                                                      PRFunction.syntaxEntry,
                                                      PRFunction.syntaxFormulaBitAt,
                                                      PRFunction.syntaxLookup,
                                                      natTraceLookupCode,
                                                      natIfZero] at accepted
                                                | succ payload =>
                                                    exact Nat.zero_lt_succ payload
                                              have childEarlier :
                                                  payload < Nat.succ
                                                    (natPair 6 payload) :=
                                                Nat.lt_succ_of_le
                                                  (natPair_right_le 6 payload)
                                              have lookup :=
                                                syntaxFormulaLookupCode_current
                                                  (Nat.succ
                                                    (natPair 6 payload))
                                                  payload childPositive
                                                  childEarlier
                                              have selected :
                                                  natUnpairRight
                                                    (natTraceLookupCode
                                                      (Nat.succ
                                                        (natPair 6 payload))
                                                      payload
                                                      (syntaxTraceValue
                                                        (natPair 6 payload))) = 1 := by
                                                simpa [syntaxEntryAt,
                                                  PRFunction.syntaxEntry,
                                                  PRFunction.syntaxFormulaBitAt,
                                                  natIfZero] using accepted
                                              have childAccepted :=
                                                lookup.symm.trans selected
                                              cases inductionHypothesis payload
                                                  childEarlier childAccepted with
                                              | intro body bodyCode =>
                                                  exact Exists.intro
                                                    (RawFormula.ex body) (by
                                                      rw [RawFormula.code,
                                                        bodyCode])
                                          | succ tag =>
                                              simp [syntaxEntryAt,
                                                PRFunction.syntaxEntry,
                                                PRFunction.syntaxFormulaBitAt,
                                                natEqualBit, natIsZero,
                                                natIfZero] at accepted
-/

private theorem childLeftEarlierFromPayload
    (current tag payload : Nat)
    (currentCode : current = Nat.succ (natPair tag payload)) :
    natUnpairLeft payload < current := by
  have pairCode := natPair_unpairLeft_unpairRight payload
  have earlier := child_left_lt_binary tag
    (natUnpairLeft payload) (natUnpairRight payload)
  have sameCurrent :
      Nat.succ
          (natPair tag
            (natPair (natUnpairLeft payload) (natUnpairRight payload))) =
        current := by
    rw [pairCode]
    exact currentCode.symm
  exact sameCurrent ▸ earlier

private theorem childRightEarlierFromPayload
    (current tag payload : Nat)
    (currentCode : current = Nat.succ (natPair tag payload)) :
    natUnpairRight payload < current := by
  have pairCode := natPair_unpairLeft_unpairRight payload
  have earlier := child_right_lt_binary tag
    (natUnpairLeft payload) (natUnpairRight payload)
  have sameCurrent :
      Nat.succ
          (natPair tag
            (natPair (natUnpairLeft payload) (natUnpairRight payload))) =
        current := by
    rw [pairCode]
    exact currentCode.symm
  exact sameCurrent ▸ earlier

private theorem positiveTermLookup_childPositive
    (current child : Nat)
    (positive :
      0 < natUnpairLeft
        (natTraceLookupCode current child
          (syntaxTraceValue current.pred))) :
    0 < child := by
  cases child with
  | zero =>
      rw [syntaxTraceLookupCode_zero] at positive
      exact (Nat.not_lt_zero 0 positive).elim
  | succ child => exact Nat.zero_lt_succ child

private theorem positiveFormulaLookup_childPositive
    (current child : Nat)
    (positive :
      0 < natUnpairRight
        (natTraceLookupCode current child
          (syntaxTraceValue current.pred))) :
    0 < child := by
  cases child with
  | zero =>
      rw [syntaxTraceLookupCode_zero] at positive
      exact (Nat.not_lt_zero 0 positive).elim
  | succ child => exact Nat.zero_lt_succ child

private theorem reconstructTermPairFromPositiveLookups
    (current tag payload : Nat)
    (currentCode : current = Nat.succ (natPair tag payload))
    (selected :
      0 < natAndBit
        (natUnpairLeft
          (natTraceLookupCode current (natUnpairLeft payload)
            (syntaxTraceValue current.pred)))
        (natUnpairLeft
          (natTraceLookupCode current (natUnpairRight payload)
            (syntaxTraceValue current.pred))))
    (reconstruct : forall child, child < current ->
      0 < natUnpairLeft (syntaxEntryAt child) ->
      Exists fun term : RawTerm => term.code = child) :
    Exists fun terms : RawTerm × RawTerm =>
      terms.1.code = natUnpairLeft payload ∧
      terms.2.code = natUnpairRight payload := by
  have lookupPositive := (natAndBit_pos_iff _ _).mp selected
  have leftPositive := positiveTermLookup_childPositive current
    (natUnpairLeft payload) lookupPositive.1
  have rightPositive := positiveTermLookup_childPositive current
    (natUnpairRight payload) lookupPositive.2
  have leftEarlier := childLeftEarlierFromPayload
    current tag payload currentCode
  have rightEarlier := childRightEarlierFromPayload
    current tag payload currentCode
  have leftLookup := syntaxTermLookupCode_current current
    (natUnpairLeft payload) leftPositive leftEarlier
  have rightLookup := syntaxTermLookupCode_current current
    (natUnpairRight payload) rightPositive rightEarlier
  have leftAccepted :
      0 < natUnpairLeft (syntaxEntryAt (natUnpairLeft payload)) := by
    exact leftLookup ▸ lookupPositive.1
  have rightAccepted :
      0 < natUnpairLeft (syntaxEntryAt (natUnpairRight payload)) := by
    exact rightLookup ▸ lookupPositive.2
  cases reconstruct _ leftEarlier leftAccepted with
  | intro left leftCode =>
      cases reconstruct _ rightEarlier rightAccepted with
      | intro right rightCode =>
          exact Exists.intro (left, right)
            (And.intro leftCode rightCode)

private theorem strictTermCode_sound_positive
    (code : Nat)
    (accepted : 0 < natUnpairLeft (syntaxEntryAt code)) :
    Exists fun term : RawTerm => term.code = code := by
  induction code using Nat.strongRecOn with
  | ind code inductionHypothesis =>
      cases code with
      | zero =>
          rw [syntaxEntryAt] at accepted
          exact (Nat.not_lt_zero 0 accepted).elim
      | succ encoded =>
          cases natPair_surjective encoded with
          | intro components decomposition =>
              cases components with
              | mk tag payload =>
                  subst encoded
                  cases tag with
                  | zero =>
                      exact Exists.intro (RawTerm.bvar payload) rfl
                  | succ tag =>
                      cases tag with
                      | zero =>
                          normalize_term_acceptance_at accepted
                          have payloadZero :=
                            (natEqualBit_pos_iff payload 0).mp accepted
                          subst payload
                          exact Exists.intro RawTerm.zero rfl
                      | succ tag =>
                          cases tag with
                          | zero =>
                              normalize_term_acceptance_at accepted
                              have childPositive :=
                                positiveTermLookup_childPositive
                                  (Nat.succ (natPair 2 payload)) payload accepted
                              have childEarlier :
                                  payload < Nat.succ (natPair 2 payload) :=
                                Nat.lt_succ_of_le
                                  (natPair_right_le 2 payload)
                              have lookup := syntaxTermLookupCode_current
                                (Nat.succ (natPair 2 payload)) payload
                                childPositive childEarlier
                              have childAccepted :
                                  0 < natUnpairLeft (syntaxEntryAt payload) := by
                                exact lookup ▸ accepted
                              cases inductionHypothesis payload childEarlier
                                  childAccepted with
                              | intro body bodyCode =>
                                  exact Exists.intro (RawTerm.succ body) (by
                                    rw [RawTerm.code, bodyCode])
                          | succ tag =>
                              cases tag with
                              | zero =>
                                  normalize_term_acceptance_at accepted
                                  cases reconstructTermPairFromPositiveLookups
                                      (Nat.succ (natPair 3 payload)) 3 payload
                                      rfl accepted inductionHypothesis with
                                  | intro terms termCodes =>
                                      exact Exists.intro
                                        (RawTerm.add terms.1 terms.2) (by
                                          rw [RawTerm.code, termCodes.1,
                                            termCodes.2,
                                            natPair_unpairLeft_unpairRight])
                              | succ tag =>
                                  cases tag with
                                  | zero =>
                                      normalize_term_acceptance_at accepted
                                      cases reconstructTermPairFromPositiveLookups
                                          (Nat.succ (natPair 4 payload)) 4 payload
                                          rfl accepted inductionHypothesis with
                                      | intro terms termCodes =>
                                          exact Exists.intro
                                            (RawTerm.mul terms.1 terms.2) (by
                                              rw [RawTerm.code, termCodes.1,
                                                termCodes.2,
                                                natPair_unpairLeft_unpairRight])
                                  | succ tag =>
                                      normalize_term_acceptance_at accepted
                                      exact (Nat.not_lt_zero 0 accepted).elim

theorem strictTermCode_sound
    (code : Nat)
    (accepted : natUnpairLeft (syntaxEntryAt code) = 1) :
    Exists fun term : RawTerm => term.code = code := by
  apply strictTermCode_sound_positive code
  rw [accepted]
  exact Nat.zero_lt_succ 0

private theorem reconstructFormulaPairFromPositiveLookups
    (current tag payload : Nat)
    (currentCode : current = Nat.succ (natPair tag payload))
    (selected :
      0 < natAndBit
        (natUnpairRight
          (natTraceLookupCode current (natUnpairLeft payload)
            (syntaxTraceValue current.pred)))
        (natUnpairRight
          (natTraceLookupCode current (natUnpairRight payload)
            (syntaxTraceValue current.pred))))
    (reconstruct : forall child, child < current ->
      0 < natUnpairRight (syntaxEntryAt child) ->
      Exists fun formula : RawFormula => formula.code = child) :
    Exists fun formulas : RawFormula × RawFormula =>
      formulas.1.code = natUnpairLeft payload ∧
      formulas.2.code = natUnpairRight payload := by
  have lookupPositive := (natAndBit_pos_iff _ _).mp selected
  have leftPositive := positiveFormulaLookup_childPositive current
    (natUnpairLeft payload) lookupPositive.1
  have rightPositive := positiveFormulaLookup_childPositive current
    (natUnpairRight payload) lookupPositive.2
  have leftEarlier := childLeftEarlierFromPayload
    current tag payload currentCode
  have rightEarlier := childRightEarlierFromPayload
    current tag payload currentCode
  have leftLookup := syntaxFormulaLookupCode_current current
    (natUnpairLeft payload) leftPositive leftEarlier
  have rightLookup := syntaxFormulaLookupCode_current current
    (natUnpairRight payload) rightPositive rightEarlier
  have leftAccepted :
      0 < natUnpairRight (syntaxEntryAt (natUnpairLeft payload)) := by
    exact leftLookup ▸ lookupPositive.1
  have rightAccepted :
      0 < natUnpairRight (syntaxEntryAt (natUnpairRight payload)) := by
    exact rightLookup ▸ lookupPositive.2
  cases reconstruct _ leftEarlier leftAccepted with
  | intro left leftCode =>
      cases reconstruct _ rightEarlier rightAccepted with
      | intro right rightCode =>
          exact Exists.intro (left, right)
            (And.intro leftCode rightCode)

private theorem strictFormulaCode_sound_positive
    (code : Nat)
    (accepted : 0 < natUnpairRight (syntaxEntryAt code)) :
    Exists fun formula : RawFormula => formula.code = code := by
  induction code using Nat.strongRecOn with
  | ind code inductionHypothesis =>
      cases code with
      | zero =>
          rw [syntaxEntryAt] at accepted
          exact (Nat.not_lt_zero 0 accepted).elim
      | succ encoded =>
          cases natPair_surjective encoded with
          | intro components decomposition =>
              cases components with
              | mk tag payload =>
                  subst encoded
                  cases tag with
                  | zero =>
                      normalize_formula_acceptance_at accepted
                      have payloadZero :=
                        (natEqualBit_pos_iff payload 0).mp accepted
                      subst payload
                      exact Exists.intro RawFormula.falsum rfl
                  | succ tag =>
                      cases tag with
                      | zero =>
                          normalize_formula_acceptance_at accepted
                          cases reconstructTermPairFromPositiveLookups
                              (Nat.succ (natPair 1 payload)) 1 payload rfl
                              accepted
                              (fun child _ childAccepted =>
                                strictTermCode_sound_positive child
                                  childAccepted) with
                          | intro terms termCodes =>
                              exact Exists.intro
                                (RawFormula.equal terms.1 terms.2) (by
                                  rw [RawFormula.code, termCodes.1,
                                    termCodes.2,
                                    natPair_unpairLeft_unpairRight])
                      | succ tag =>
                          cases tag with
                          | zero =>
                              normalize_formula_acceptance_at accepted
                              cases reconstructFormulaPairFromPositiveLookups
                                  (Nat.succ (natPair 2 payload)) 2 payload rfl
                                  accepted inductionHypothesis with
                              | intro formulas codes =>
                                  exact Exists.intro
                                    (RawFormula.conj formulas.1 formulas.2) (by
                                      rw [RawFormula.code, codes.1, codes.2,
                                        natPair_unpairLeft_unpairRight])
                          | succ tag =>
                              cases tag with
                              | zero =>
                                  normalize_formula_acceptance_at accepted
                                  cases reconstructFormulaPairFromPositiveLookups
                                      (Nat.succ (natPair 3 payload)) 3 payload
                                      rfl accepted inductionHypothesis with
                                  | intro formulas codes =>
                                      exact Exists.intro
                                        (RawFormula.disj formulas.1 formulas.2)
                                        (by
                                          rw [RawFormula.code, codes.1,
                                            codes.2,
                                            natPair_unpairLeft_unpairRight])
                              | succ tag =>
                                  cases tag with
                                  | zero =>
                                      normalize_formula_acceptance_at accepted
                                      cases reconstructFormulaPairFromPositiveLookups
                                          (Nat.succ (natPair 4 payload)) 4
                                          payload rfl accepted
                                          inductionHypothesis with
                                      | intro formulas codes =>
                                          exact Exists.intro
                                            (RawFormula.impl
                                              formulas.1 formulas.2) (by
                                                rw [RawFormula.code, codes.1,
                                                  codes.2,
                                                  natPair_unpairLeft_unpairRight])
                                  | succ tag =>
                                      cases tag with
                                      | zero =>
                                          normalize_formula_acceptance_at accepted
                                          have childPositive :=
                                            positiveFormulaLookup_childPositive
                                              (Nat.succ (natPair 5 payload))
                                              payload accepted
                                          have childEarlier :
                                              payload <
                                                Nat.succ (natPair 5 payload) :=
                                            Nat.lt_succ_of_le
                                              (natPair_right_le 5 payload)
                                          have lookup :=
                                            syntaxFormulaLookupCode_current
                                              (Nat.succ (natPair 5 payload))
                                              payload childPositive childEarlier
                                          have childAccepted :
                                              0 < natUnpairRight
                                                (syntaxEntryAt payload) := by
                                            exact lookup ▸ accepted
                                          cases inductionHypothesis payload
                                              childEarlier childAccepted with
                                          | intro body bodyCode =>
                                              exact Exists.intro
                                                (RawFormula.all body) (by
                                                  rw [RawFormula.code,
                                                    bodyCode])
                                      | succ tag =>
                                          cases tag with
                                          | zero =>
                                              normalize_formula_acceptance_at accepted
                                              have childPositive :=
                                                positiveFormulaLookup_childPositive
                                                  (Nat.succ
                                                    (natPair 6 payload))
                                                  payload accepted
                                              have childEarlier :
                                                  payload < Nat.succ
                                                    (natPair 6 payload) :=
                                                Nat.lt_succ_of_le
                                                  (natPair_right_le 6 payload)
                                              have lookup :=
                                                syntaxFormulaLookupCode_current
                                                  (Nat.succ
                                                    (natPair 6 payload))
                                                  payload childPositive
                                                  childEarlier
                                              have childAccepted :
                                                  0 < natUnpairRight
                                                    (syntaxEntryAt payload) := by
                                                exact lookup ▸ accepted
                                              cases inductionHypothesis payload
                                                  childEarlier childAccepted with
                                              | intro body bodyCode =>
                                                  exact Exists.intro
                                                    (RawFormula.ex body) (by
                                                      rw [RawFormula.code,
                                                        bodyCode])
                                          | succ tag =>
                                              normalize_formula_acceptance_at accepted
                                              exact
                                                (Nat.not_lt_zero 0 accepted).elim

theorem strictFormulaCode_sound
    (code : Nat)
    (accepted : natUnpairRight (syntaxEntryAt code) = 1) :
    Exists fun formula : RawFormula => formula.code = code := by
  apply strictFormulaCode_sound_positive code
  rw [accepted]
  exact Nat.zero_lt_succ 0

end HeytingArithmetic
end RelationalPerimeter

