private theorem strictTermPair_sound
    (tag payload : Nat)
    (selected :
      natAndBit
        (natUnpairLeft
          (natTraceLookupCode (Nat.succ (natPair tag payload))
            (natUnpairLeft payload) (syntaxTraceValue (natPair tag payload))))
        (natUnpairLeft
          (natTraceLookupCode (Nat.succ (natPair tag payload))
            (natUnpairRight payload) (syntaxTraceValue (natPair tag payload)))) = 1) :
    Exists fun terms : RawTerm × RawTerm =>
      terms.1.code = natUnpairLeft payload ∧
      terms.2.code = natUnpairRight payload := by
  have lookupPositive := (natAndBit_eq_one_iff _ _).mp selected
  have leftPositive : 0 < natUnpairLeft payload := by
    cases left : natUnpairLeft payload with
    | zero =>
        rw [left] at selected
        simp [natTraceLookupCode, natIfZero] at selected
    | succ left => exact Nat.zero_lt_succ left
  have rightPositive : 0 < natUnpairRight payload := by
    cases right : natUnpairRight payload with
    | zero =>
        rw [right] at selected
        simp [natTraceLookupCode, natIfZero] at selected
    | succ right => exact Nat.zero_lt_succ right
  have leftEarlier :
      natUnpairLeft payload < Nat.succ (natPair tag payload) := by
    rw [← natPair_unpairLeft_unpairRight payload]
    exact child_left_lt_binary tag _ _
  have rightEarlier :
      natUnpairRight payload < Nat.succ (natPair tag payload) := by
    rw [← natPair_unpairLeft_unpairRight payload]
    exact child_right_lt_binary tag _ _
  have leftLookup := syntaxTermLookupCode_current
    (Nat.succ (natPair tag payload)) (natUnpairLeft payload)
    leftPositive leftEarlier
  have rightLookup := syntaxTermLookupCode_current
    (Nat.succ (natPair tag payload)) (natUnpairRight payload)
    rightPositive rightEarlier
  have leftAccepted :
      natUnpairLeft (syntaxEntryAt (natUnpairLeft payload)) = 1 :=
    (natPositiveBit_eq_one_iff _).mpr
      (leftLookup.symm ▸ lookupPositive.1)
  have rightAccepted :
      natUnpairLeft (syntaxEntryAt (natUnpairRight payload)) = 1 :=
    (natPositiveBit_eq_one_iff _).mpr
      (rightLookup.symm ▸ lookupPositive.2)
  cases strictTermCode_sound _ leftAccepted with
  | intro left leftCode =>
      cases strictTermCode_sound _ rightAccepted with
      | intro right rightCode =>
          exact Exists.intro (left, right)
            (And.intro leftCode rightCode)

private theorem strictFormulaPair_sound
    (current tag payload : Nat)
