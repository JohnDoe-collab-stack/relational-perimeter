import RelationalPerimeter.Instances.HeytingArithmetic.InternalDerivationTools
import RelationalPerimeter.Instances.HeytingArithmetic.InternalExistentialBlocks

/-!
# Constructive elimination of finite existential blocks

`existsManyEliminationContext` records every intermediate existential
hypothesis generated by natural-deduction elimination.  The continuation
receives the fully opened body and cannot let any witness escape its scope.
-/

namespace RelationalPerimeter
namespace HeytingArithmetic

def existsManyEliminationContext
    {bound : Nat} :
    (count : Nat) ->
    ScopedFormula (count + bound) ->
    FormulaContext bound ->
    FormulaContext (count + bound)
  | 0, _body, context => context.liftMany 0
  | Nat.succ count, body, context =>
      let sameBound := Nat.succ_add count bound
      let normalizedBody : ScopedFormula (Nat.succ (count + bound)) :=
        Eq.mp (congrArg ScopedFormula sameBound) body
      Eq.mpr (congrArg FormulaContext sameBound)
        (FormulaContext.cons normalizedBody
          (existsManyEliminationContext count
            (ScopedFormula.ex normalizedBody) context).lift)

def Derivation.eliminateExistsMany
    {mode : LogicMode}
    {theory : ArithmeticTheory}
    {bound : Nat}
    {context : FormulaContext bound}
    {conclusion : ScopedFormula bound}
    (count : Nat)
    (body : ScopedFormula (count + bound))
    (block : Derivation mode theory context
      { raw := body.raw.existsMany count
        isScoped := RawFormula.existsMany_wellScoped count bound body.raw
          body.isScoped })
    (branch :
      Derivation mode theory
          (existsManyEliminationContext count body context) body ->
        Derivation mode theory
          (existsManyEliminationContext count body context)
          (conclusion.liftMany count)) :
    Derivation mode theory context conclusion := by
  induction count generalizing context conclusion with
  | zero =>
      let sourceFormula : ScopedFormula bound :=
        { raw := body.raw.existsMany 0
          isScoped := RawFormula.existsMany_wellScoped 0 bound body.raw
            body.isScoped }
      let liftedBlock := Derivation.transportBound
        (Nat.zero_add bound).symm
        (show Derivation mode theory context sourceFormula from block)
      have opened : Derivation mode theory
          (existsManyEliminationContext 0 body context) body := by
        let transportedFormula := Eq.mp
          (congrArg ScopedFormula (Nat.zero_add bound).symm) sourceFormula
        have sameRaw : transportedFormula.raw = body.raw := by
          calc
            transportedFormula.raw = sourceFormula.raw :=
              ScopedFormula.transport_raw
                (Nat.zero_add bound).symm sourceFormula
            _ = body.raw := rfl
        exact Derivation.castConclusion
          (ScopedFormula.eq_of_raw_eq sameRaw) liftedBlock
      let result := branch opened
      simpa [ScopedFormula.liftMany,
        existsManyEliminationContext, FormulaContext.liftMany] using
        Derivation.transportBound (Nat.zero_add bound) result
  | succ count inductionHypothesis =>
      let sameBound := Nat.succ_add count bound
      let normalizedBody : ScopedFormula (Nat.succ (count + bound)) :=
        Eq.mp (congrArg ScopedFormula sameBound) body
      let existentialBody : ScopedFormula (count + bound) :=
        ScopedFormula.ex normalizedBody
      let sourceFormula : ScopedFormula bound :=
        { raw := body.raw.existsMany (Nat.succ count)
          isScoped := RawFormula.existsMany_wellScoped
            (Nat.succ count) bound body.raw body.isScoped }
      let targetFormula : ScopedFormula bound :=
        { raw := existentialBody.raw.existsMany count
          isScoped := RawFormula.existsMany_wellScoped count bound
            existentialBody.raw existentialBody.isScoped }
      let normalizedBlock : Derivation mode theory context
          targetFormula := by
        have normalizedRaw : normalizedBody.raw = body.raw :=
          ScopedFormula.transport_raw sameBound body
        have sameRaw : sourceFormula.raw = targetFormula.raw := by
          change body.raw.existsMany (Nat.succ count) =
            (RawFormula.ex normalizedBody.raw).existsMany count
          rw [RawFormula.existsMany_succ, normalizedRaw]
        exact Derivation.castConclusion
          (ScopedFormula.eq_of_raw_eq sameRaw)
          (show Derivation mode theory context sourceFormula from block)
      apply inductionHypothesis existentialBody normalizedBlock
      intro openedExistential
      let openedContext := existsManyEliminationContext count
        existentialBody context
      let normalizedContext := FormulaContext.cons normalizedBody
        openedContext.lift
      let normalizedHypothesis : Derivation mode theory normalizedContext
          normalizedBody := Derivation.hypothesis ContextMember.here
      have successorHypothesis : Derivation mode theory
          (existsManyEliminationContext (Nat.succ count) body context)
          body := by
        simpa [existsManyEliminationContext, sameBound,
          normalizedBody, existentialBody, openedContext,
          normalizedContext] using
          Derivation.transportBound sameBound.symm normalizedHypothesis
      let successorResult := branch successorHypothesis
      have normalizedResult : Derivation mode theory normalizedContext
          (conclusion.liftMany count).lift := by
        simpa [existsManyEliminationContext, sameBound,
          normalizedBody, existentialBody, openedContext,
          normalizedContext,
          ScopedFormula.liftMany] using
          Derivation.transportBound sameBound successorResult
      exact Derivation.existentialElimination openedExistential
        normalizedResult

end HeytingArithmetic
end RelationalPerimeter

