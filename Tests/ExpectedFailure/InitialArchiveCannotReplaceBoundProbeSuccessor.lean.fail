import RelationalPerimeter.Constitution.Reals.RelationalRealDensity
set_option autoImplicit false
open StrongPerimetralTurning
open RelationalPerimeter.Constitution.Reals
open HeterogeneousRealRuntime RelationalRealAddition RelationalRealDensity ConstitutiveRuntime

example {P : CircularPresentation} {d : Nat} {source : Real P d} {archive : (environment source).Archive}
    {journal : Journal P d} (packet : NaturalBound source archive journal) :
    Step (environment source) (environment source).initialArchive 5 :=
  packet.lower.pair.right
