import RelationalPerimeter
set_option genInjectivity false
namespace Tests.ExpectedFailure.InitialStateCannotReplaceProducedFinalState
open ConstitutiveSearch.NeuralAgent

def chain :
    PublicConstitutiveAlignmentCertificate
      ⟨.scopeZero, .direct⟩ ⟨.scopeOne, .direct⟩ [] :=
  constitutive_alignment ⟨.scopeZero, .direct⟩ ⟨.scopeOne, .direct⟩ []

-- The output of forgetting is computed by the historical program and tied to
-- the continuation final memory; it cannot be replaced by the initial memory.
example :
    chain.forgottenLeftExecution.output = chain.initialState.memory := by
  rfl

end Tests.ExpectedFailure.InitialStateCannotReplaceProducedFinalState
/- AXIOM_AUDIT_BEGIN -/
#print axioms ConstitutiveSearch.NeuralAgent.constitutive_alignment
/- AXIOM_AUDIT_END -/
