import RelationalPerimeter.Constitution.Reals.RelationalRealInverseLaws
set_option autoImplicit false
open StrongPerimetralTurning
open RelationalPerimeter.Constitution.Reals
open HeterogeneousRealRuntime RelationalRealAddition RelationalRealOrder RelationalRealInverse DyadicReciprocal

example {P : CircularPresentation} {depth p : Nat} (source : Real P depth)
