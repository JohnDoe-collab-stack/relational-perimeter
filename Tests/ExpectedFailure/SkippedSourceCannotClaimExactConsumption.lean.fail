import RelationalPerimeter.Constitution.Reals.ProducedCompleteness

open StrongPerimetralTurning
open RelationalPerimeter.Constitution.Reals.ConstitutiveRuntime
open RelationalPerimeter.Constitution.Reals.ProducedCompleteness

-- Consumption of a prefix cannot claim consumption of its fresh successor.
example
    {P : CircularPresentation}
    {family : ExecutedCauchyFamily P 1}
    {precision size : Nat}
    {start current targetJournal : Journal P 1}
    (target : family.DiagonalAnchor targetJournal precision)
    (prior : family.ExecutedSourceChain precision start current size)
    (source : family.SourceAt precision)
    (produced : family.ProducedSourceAt current source)
    (consumedPrior : family.ExactConsumption target prior) :
    family.ExactConsumption target (.snoc prior source produced) :=
  consumedPrior
