import RelationalPerimeter.Instances.HeytingArithmetic.Tarski
open StrongPerimetralTurning
open RelationalPerimeter.HeytingArithmetic

structure SentenceOnlyTarskiProduction (candidate : Predicate) where
  sentence : Sentence
  diagonalExact : sentence = diagonal candidate

variable {candidate : Predicate}

example (production : SentenceOnlyTarskiProduction candidate) :
    HATarskiExecution candidate := production

