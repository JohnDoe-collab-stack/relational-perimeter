import RelationalPerimeter.Constitution.Reals.RelationalRealInverseLaws
set_option autoImplicit false
open StrongPerimetralTurning
open RelationalPerimeter.Constitution.Reals
open HeterogeneousRealRuntime RelationalRealAddition RelationalRealOrder RelationalRealInverse DyadicReciprocal

example {P : CircularPresentation} {depth p : Nat} (source : Real P depth) (w : Apartness source (zero P depth))
    (archive : (environment (inverse source w)).Archive) (step : Step (environment (inverse source w)) archive p) :
    ReciprocalRuntime.Action step.resource.operand :=
  computeReciprocal (ReciprocalDomain.direction w) step.resource.sourceStep.code (roundingPrecision p) step.resource.nonzero.positive
