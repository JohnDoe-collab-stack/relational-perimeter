import RelationalPerimeter

namespace Tests.ExpectedFailure.SkippedBatchCannotClaimAllSources

open StrongPerimetralTurning.GodelGroupingTower
open RelationalPerimeter.Constitution.Reals

-- The unexecuted initial charge cannot claim that a two-source batch was consumed.
example
    {P : StrongPerimetralTurning.CircularPresentation}
    {family : ExecutedCauchyFamily P}
    {precision : Nat}
    {initial final : OperationJournal ApproximationPayload}
    (chain : ExecutedSourceChain family precision initial final 2) :
    (HistoricalGrouping.initialBatchCharge
      chain.selection).consumed.length = 2 := by
  rfl

end Tests.ExpectedFailure.SkippedBatchCannotClaimAllSources
