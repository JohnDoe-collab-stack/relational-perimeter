import RelationalPerimeter.Constitution.Reals.RelationalRealCauchy
open StrongPerimetralTurning RelationalPerimeter.Constitution.Reals
open ProducedCompleteness RelationalRealAddition HeterogeneousRealRuntime RelationalRealCauchy
variable {P : CircularPresentation} {d : Nat} (family : ExecutedCauchyFamily P d)
example (archive : TermArchive family) :
    Step (environment (limitReal family)) archive 3 :=
  AuthoritativeRuntime.performRawSource family archive.state { term := family.modulus 3, precision := 3 }
