import RelationalPerimeter.Instances.HeytingArithmetic.GodelTheoryProgression
open StrongPerimetralTurning RelationalPerimeter.HeytingArithmetic
set_option maxRecDepth 1000000

variable {history : TheoryHistory} {sound : SoundTheoryHistory history}
  (step : ExecutedGodelTheoryProgression sound)

example (external : Sentence)
    (sameTruth : external.models =
      step.sourceExecution.witness.production.sentence.models) :
    SoundTheoryHistory step.targetHistory := by
  let externalTruth : PLift external.models :=
    ⟨Eq.mpr sameTruth step.sourceExecution.witness.trueWitness.down⟩
  exact SoundTheoryHistory.extend (sentence := external) sound externalTruth

/- AXIOM_AUDIT_BEGIN -/
#print axioms RelationalPerimeter.HeytingArithmetic.executeGodelTheoryProgression
/- AXIOM_AUDIT_END -/
