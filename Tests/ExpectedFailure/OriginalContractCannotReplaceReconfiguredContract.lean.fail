import RelationalPerimeter
set_option genInjectivity false
namespace Tests.ExpectedFailure.OriginalContractCannotReplaceReconfiguredContract
open ConstitutiveSearch.NeuralAgent
open ConstitutiveSearch.ContinuationSignatures

-- The fixed-system interaction contract cannot replace the future contract
-- whose state contains and advances the produced native system.
def wrongContract :
    FutureContract PublicReconfiguredHistoricalSource
      (ULift.{3} PublicRequirementInput)
      ConstitutiveSearch.Agent.Event ConstitutiveSearch.Agent.Memory :=
  interactionFutureContract publicRequirementSignalPreservation
    publicAgentActionChannel

end Tests.ExpectedFailure.OriginalContractCannotReplaceReconfiguredContract
/- AXIOM_AUDIT_BEGIN -/
#print axioms ConstitutiveSearch.NeuralAgent.reconfiguredFutureContract
/- AXIOM_AUDIT_END -/
