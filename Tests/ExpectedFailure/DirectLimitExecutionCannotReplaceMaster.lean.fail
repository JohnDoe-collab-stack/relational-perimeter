import RelationalPerimeter

namespace Tests.ExpectedFailure.DirectLimitExecutionCannotReplaceMaster

open StrongPerimetralTurning
open StrongPerimetralTurning.GodelGroupingTower
open RelationalPerimeter.Constitution.Reals

-- A direct limit response omits the owned source execution and grouping action.
example
    {P : CircularPresentation}
    (family : ExecutedCauchyFamily P)
    (journal : OperationJournal ApproximationPayload)
    (precision : Nat)
    (direct : ExecutedApproximation P journal
      (limitPayload precision (family.limitApproximation precision))) :
    ExecutedLimitProduction family journal precision :=
  direct

end Tests.ExpectedFailure.DirectLimitExecutionCannotReplaceMaster
