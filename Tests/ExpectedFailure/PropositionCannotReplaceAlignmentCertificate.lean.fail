import RelationalPerimeter
set_option genInjectivity false
namespace Tests.ExpectedFailure.PropositionCannotReplaceAlignmentCertificate
open ConstitutiveSearch.NeuralAgent

-- The final result requires its dependent witnesses; a proposition is not a
-- substitute for the constitutive chain.
def forgedCertificate :
    PublicConstitutiveAlignmentCertificate
      ⟨.scopeZero, .direct⟩ ⟨.scopeOne, .direct⟩ [] :=
  True.intro

end Tests.ExpectedFailure.PropositionCannotReplaceAlignmentCertificate
/- AXIOM_AUDIT_BEGIN -/
#print axioms ConstitutiveSearch.NeuralAgent.ConstitutiveAlignmentCertificate
/- AXIOM_AUDIT_END -/
