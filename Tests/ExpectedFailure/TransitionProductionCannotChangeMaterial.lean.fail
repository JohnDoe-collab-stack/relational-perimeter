import RelationalPerimeter.Agents.Neural.TransitionProduction

open ConstitutiveSearch.NeuralAgent

def differentTransitionMaterial :
    publicTransitionProductionKernel.Material .initial .reconfigured :=
  .reconfigure ⟨.scopeOne, .reversed⟩

def impossibleMaterialSubstitution :
    ExecutedTransitionProduction publicTransitionProductionKernel
      publicInitialCheckedAgent publicOperationalTransition
      differentTransitionMaterial :=
  publicReferenceTransitionProduction

