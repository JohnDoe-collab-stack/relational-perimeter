import RelationalPerimeter.Constitution.Reals.RelationalRealDensity
set_option autoImplicit false
open StrongPerimetralTurning
open RelationalPerimeter.Constitution.Reals
open HeterogeneousRealRuntime RelationalRealAddition RelationalRealOrder RelationalRealDensity ConstitutiveRuntime

example {P : CircularPresentation} {d : Nat} {a b : Real P d} {origin : StrictOrder a b} {journal : Journal P d}
    (packet : Density origin journal) :
    Step (environment packet.target) (environment packet.target).initialArchive (origin.accuracy + 6) :=
  packet.right.pair.left
