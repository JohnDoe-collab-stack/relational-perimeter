import RelationalPerimeter.Agents.Neural.AutonomousContractTransitions
import RelationalPerimeter.Agents.Neural.ReferenceChecker

open ConstitutiveSearch.NeuralAgent

def forbiddenReversePostForgettingTransition :
    JustifiedPostForgettingTransition publicReferenceNextCheckedAgent
      (forgotten := forgetCurrentAgent publicReferenceNextCheckedAgent)
      PublicOperationalContract.initial where
  reducedMemory := (forgetCurrentAgent publicReferenceNextCheckedAgent).memory
  reducedMemoryExact := rfl
  transition := publicOperationalTransition
  persistentSource := fun obligation => by
    cases obligation
    exact { exact := public_required_action_distinction }

/- AXIOM_AUDIT_BEGIN -/
#print axioms ConstitutiveSearch.NeuralAgent.JustifiedPostForgettingTransition
/- AXIOM_AUDIT_END -/
