import RelationalPerimeter.Constitution.Reals.RelationalRealOrderedField
set_option autoImplicit false
open StrongPerimetralTurning
open RelationalPerimeter.Constitution.Reals
open HeterogeneousRealRuntime RelationalRealAddition RelationalRealOrder RelationalRealOrderedField RelationalRealMultiplication

example {P : CircularPresentation} {d : Nat} {a b : Real P d} {left : Positive a} {right : Positive b}
    {za : (environment (zero P d)).Archive} {archive : (environment (.mul a b)).Archive}
    (packet : PositiveProduct left right za archive) :
    Step (environment a) (environment a).initialArchive
      (productBudget packet.attempt.pair.right.resource.leftProbe.code
        packet.attempt.pair.right.resource.rightProbe.code (positiveProductAccuracy left right + 3)).leftPrecision :=
  packet.attempt.pair.right.resource.left
