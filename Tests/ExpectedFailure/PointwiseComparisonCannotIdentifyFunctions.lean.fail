import RelationalPerimeter.Constitution.Reals.DyadicCompletionCharacterization
open RelationalPerimeter.Constitution.Reals PresentedDyadicCompletion DyadicCompletionCharacterization
example (Source Target : PresentedDyadicCompletionObject) (f g : CompletionMorphism Source Target)
