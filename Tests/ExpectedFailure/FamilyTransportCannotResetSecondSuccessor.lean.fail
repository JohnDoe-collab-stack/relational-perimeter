import RelationalPerimeter.Constitution.Reals.RelationalRealFamilyTransport
open StrongPerimetralTurning RelationalPerimeter.Constitution.Reals
open ProducedCompleteness RuntimeCorrespondence HeterogeneousRealRuntime RelationalRealAddition RelationalRealCauchy RelationalRealLimitUniqueness RelationalRealFamilyTransport
variable {P : CircularPresentation} {d : Nat}
example (family : ExecutedCauchyFamily P d) (ta : TermArchive (returnedFamily family))
    (a : (environment (limitReal (returnedFamily family))).Archive)
    (b : (environment (limitReal family)).Archive)
    (query : LimitQuery (uniquenessThreshold (returnedAuthoritative family) (returnedCandidate family)))
    (packet : Mediation (returnedAuthoritative family) (returnedCandidate family) ta a b query) :
    Step (environment (limitReal family)) packet.secondStep.next 3 :=
  executeReal (limitReal family) 3
