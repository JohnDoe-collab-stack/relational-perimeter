import RelationalPerimeter
open RelationalPerimeter.Relativity.Production.Encounter
open RelationalPerimeter.Relativity.Reconstruction
example {source result coarse} (prior : @MeasuredDescriptionRun source result coarse)
    (request : MeasuredPrecisionRequest) : MeasurementRun result.next :=
  runMeasurements prior.realization.state [request.subdivision]
