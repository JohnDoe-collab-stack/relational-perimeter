import RelationalPerimeter.Constitution.Reals.RelationalRealOrder
set_option autoImplicit false
open StrongPerimetralTurning
open RelationalPerimeter.Constitution.Reals
open RelationalRealAddition RelationalRealOrder

example {P : CircularPresentation} {d : Nat} (a b : Real P d) :
    Apartness a b ⊕ Equivalent a b :=
  (compareCurrent a b (environment a).initialArchive (environment b).initialArchive 0).apartness?
