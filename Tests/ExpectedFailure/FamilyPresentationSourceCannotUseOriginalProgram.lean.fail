import RelationalPerimeter.Constitution.Reals.RelationalRealFamilyTransport
open StrongPerimetralTurning RelationalPerimeter.Constitution.Reals
open ProducedCompleteness RuntimeCorrespondence HeterogeneousRealRuntime RelationalRealAddition RelationalRealCauchy RelationalRealLimitUniqueness RelationalRealFamilyTransport
variable {P : CircularPresentation} {d : Nat}
example (family : ExecutedCauchyFamily P d)
    (archive : (environment (ofPresentation P d (toPresentation (limitReal family)))).Archive)
    (s : Nat) (step : Step (environment (ofPresentation P d (toPresentation (limitReal family)))) archive s) :
    ConstitutiveRuntime.ExecutedRequest (sourceProgram family.producer) P archive.state.journal
      step.resource.response.limitProduction.sourceAt.request :=
  step.resource.response.limitProduction.source.execution
