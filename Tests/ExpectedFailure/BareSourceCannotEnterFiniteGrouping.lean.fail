import RelationalPerimeter

namespace Tests.ExpectedFailure.BareSourceCannotEnterFiniteGrouping

open RelationalPerimeter.Constitution.Reals

-- A certified numerical source is not an executed source profile.
example
    {P : StrongPerimetralTurning.CircularPresentation}
    {family : ExecutedCauchyFamily P}
    {precision size : Nat}
    (selection : HistoricalGrouping.FiniteSelection
      (family.groupingEnvelope precision) size)
    (source : family.SourceAt precision) :
    HistoricalGrouping.FiniteSelection
      (family.groupingEnvelope precision) (size + 1) :=
  selection.snoc source

end Tests.ExpectedFailure.BareSourceCannotEnterFiniteGrouping
