import RelationalPerimeter
set_option genInjectivity false
namespace Tests.ExpectedFailure.ContextSubstitutionCannotReuseAuthorization
open ConstitutiveSearch.NeuralAgent

def source : PublicRequirementInput := ⟨.scopeZero, .direct⟩
def intended : PublicRequirementInput := ⟨.scopeOne, .direct⟩
def contextSubstitute : PublicRequirementInput := ⟨.scopeOne, .reversed⟩

def authorizationForSubstitutedContext :=
  publicReconfigurationAuthorization contextSubstitute

/-- Authorization indexed by another context cannot enter the intended
constitutive reconfiguration. -/
def forbiddenContextSubstitution :
    Reconfiguration publicReconfigurationBuilder publicRequirementSystem
      source intended :=
  reconfigure publicReconfigurationBuilder source intended
    authorizationForSubstitutedContext

end Tests.ExpectedFailure.ContextSubstitutionCannotReuseAuthorization
/- AXIOM_AUDIT_BEGIN -/
#print axioms ConstitutiveSearch.NeuralAgent.reconfigure
/- AXIOM_AUDIT_END -/
