import RelationalPerimeter.Constitution.Godel.OperationalClosure
open StrongPerimetralTurning ConstitutiveSearch ConstitutiveSearch.ContinuationSignatures
variable {coding : GodelDiagonalSyntax} {formula : coding.UnaryFormula}
  {interpretation : GodelProvabilityInterpretation coding formula}
  (execution : ExecutedGodelProduction coding formula interpretation)

example (sameValue : (semanticSource execution).difference = (syntacticSource execution).difference) :
    (godelAffirmativeConstitution execution).productionOccurrence =
      (godelAffirmativeConstitution execution).certificationOccurrence := sameValue

