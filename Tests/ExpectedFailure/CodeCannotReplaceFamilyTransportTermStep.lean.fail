import RelationalPerimeter.Constitution.Reals.RelationalRealFamilyTransport
open StrongPerimetralTurning RelationalPerimeter.Constitution.Reals
open ProducedCompleteness RuntimeCorrespondence HeterogeneousRealRuntime RelationalRealAddition RelationalRealCauchy RelationalRealLimitUniqueness RelationalRealFamilyTransport
variable {P : CircularPresentation} {d : Nat}
example (family : ExecutedCauchyFamily P d) (n p : Nat) (archive : TermArchive (returnedFamily family))
    (code : SignedDyadicCode) :
    Step (environment (termReal (returnedFamily family) n)) archive p :=
  code
