import RelationalPerimeter.Constitution.Reals.RelationalRealMultiplication
set_option autoImplicit false
open StrongPerimetralTurning
open RelationalPerimeter.Constitution.Reals
open RelationalPerimeter.Constitution.Reals.ConstitutiveRuntime
open RelationalPerimeter.Constitution.Reals.HeterogeneousRealRuntime
open RelationalPerimeter.Constitution.Reals.RelationalRealMultiplication
variable {P : CircularPresentation} {d : Nat}
variable (left right : Service P d) (la : left.Archive) (ra : right.Archive)
def forgedMultiplicationArchive (code : SignedDyadicCode) : MultiplicationArchive left right :=
  MultiplicationArchive.mk la ra (Journal.root P d) [] (some code)
