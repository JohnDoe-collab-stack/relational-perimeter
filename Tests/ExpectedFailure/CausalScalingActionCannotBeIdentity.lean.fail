import RelationalPerimeter.Agents.Neural.CausalParameterizedCompiledCheckerFamily
namespace Tests.ExpectedFailure.CausalScalingActionCannotBeIdentity
open ConstitutiveSearch.NeuralAgent

def identityRegister
    (source : ReconfiguredExecutionState publicRequirementFamily)
    (size : Nat) (version : ScalingArtifactVersion) :
    (causalScalingAction source size version).result.1.register.length =
      source.memory.register.length :=
  causalScalingAction_register_progress source size version

end Tests.ExpectedFailure.CausalScalingActionCannotBeIdentity
