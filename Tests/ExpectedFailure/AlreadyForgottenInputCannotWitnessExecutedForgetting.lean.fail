import RelationalPerimeter
set_option genInjectivity false
namespace Tests.ExpectedFailure.AlreadyForgottenInputCannotWitnessExecutedForgetting
open ConstitutiveSearch.NeuralAgent

def source : PublicRequirementInput := ⟨.scopeZero, .direct⟩

-- The program is indexed by the rich state containing the origin and current
-- reconfigured execution.  An already reduced memory cannot enter C8.
def forbiddenReducedInput :
    HistoricalForgettingInput
      (publicHistoricalForgettingProgram source []) where
  origin := publicActionMemory

end Tests.ExpectedFailure.AlreadyForgottenInputCannotWitnessExecutedForgetting
/- AXIOM_AUDIT_BEGIN -/
#print axioms ConstitutiveSearch.NeuralAgent.publicHistoricalForgettingProgram
/- AXIOM_AUDIT_END -/
