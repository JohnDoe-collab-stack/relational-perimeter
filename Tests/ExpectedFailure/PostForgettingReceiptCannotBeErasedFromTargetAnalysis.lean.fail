open ConstitutiveSearch ConstitutiveSearch.NeuralAgent

def targetAnalysisCannotIgnoreExecutionReceipt
    (left right : LearnedPostForgettingExecutionReceipt) :
    (executeLearnedPostForgettingContractResources
      learnedSuccessiveIncrementalSuccess.analysis
      learnedPostForgettingExtendedJustification left).targetAnalysis =
    (executeLearnedPostForgettingContractResources
      learnedSuccessiveIncrementalSuccess.analysis
      learnedPostForgettingExtendedJustification right).targetAnalysis := by
  rfl

