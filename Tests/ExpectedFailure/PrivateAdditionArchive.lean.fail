import RelationalPerimeter.Constitution.Reals.RelationalRealAddition
set_option autoImplicit false
open StrongPerimetralTurning
open RelationalPerimeter.Constitution.Reals
open RelationalPerimeter.Constitution.Reals.ConstitutiveRuntime
open RelationalPerimeter.Constitution.Reals.HeterogeneousRealRuntime
open RelationalPerimeter.Constitution.Reals.RelationalRealAddition
variable {P : CircularPresentation} {d : Nat}
variable (left right : Service P d) (la : left.Archive) (ra : right.Archive)
def forgedAdditionArchive (code : SignedDyadicCode) : AdditionArchive left right :=
  AdditionArchive.mk la ra (Journal.root P d) [] (some code)
