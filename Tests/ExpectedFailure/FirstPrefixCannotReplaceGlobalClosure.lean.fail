import RelationalPerimeter

namespace Tests.ExpectedFailure.FirstPrefixCannotReplaceGlobalClosure

open StrongPerimetralTurning
open StrongPerimetralTurning.GodelRelationalCompleteness
open RelationalPerimeter.HeytingArithmetic

-- One depth-one admission cannot be reused as an action at every finite depth.
example
    (admission :
      GodelPositiveSameRegimeAdmission heytingArithmeticGodelExecution) :
    GlobalSameRegimeClosure heytingArithmeticGodelExecution :=
  GlobalSameRegimeClosure.mk (fun _depth : Nat => admission)

end Tests.ExpectedFailure.FirstPrefixCannotReplaceGlobalClosure
